APP_NAME="Nexus Framework"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Vite Hot Module Replacement (HMR) Settings
VITE_DEV_SERVER_URL=http://localhost:5173

# Database Connection (Default: SQLite, supports MySQL/PostgreSQL via PDO)
DB_CONNECTION=sqlite
DB_DATABASE=database/nexus.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=""

# Filesystem & Storage Settings
FILESYSTEM_DISK=local
