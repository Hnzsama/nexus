/**
 * Generate OpenAPI 3.0 static JSON file.
 */
function runSwaggerGenerate(): void
{
    printBanner();
    echo COLOR_CYAN . "⚡ Memulai pemindaian anotasi & atribut OpenAPI 3.0...\n" . COLOR_RESET;
    try {
        $configPath = base_path('config/swagger.php');
        $config = file_exists($configPath) ? require $configPath : [];

        $scanPaths = $config['scan_paths'] ?? [
            base_path('app/OpenApi'),
            base_path('app/Handlers'),
        ];
        $outputFile = $config['output_file'] ?? public_path('openapi.json');

        $validPaths = array_values(array_filter($scanPaths, fn($p) => is_dir((string)$p) || file_exists((string)$p)));

        $generator = new \OpenApi\Generator();
        $openapi = $generator->generate($validPaths);

        if (!$openapi) {
            echo COLOR_RED . "✖ Gagal meng-generate spesifikasi OpenAPI.\n" . COLOR_RESET;
            exit(1);
        }

        $json = $openapi->toJson();
        $dir = dirname($outputFile);
        if (!is_dir($dir)) {
            mkdir($dir, 0755, true);
        }
        file_put_contents($outputFile, $json);

        echo COLOR_GREEN . "✔ OpenAPI JSON berhasil di-generate:" . COLOR_RESET . " " . $outputFile . "\n\n";
    } catch (\Throwable $e) {
        echo COLOR_RED . "✖ Terjadi kesalahan: " . $e->getMessage() . COLOR_RESET . "\n";
        exit(1);
    }
}

