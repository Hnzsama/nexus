/**
 * Menjalankan PHP local development server dan Vite dev server (HMR)
 * secara concurrent dalam satu proses terminal.
 */
function runDevServer(): void
{
    printBanner();
    echo COLOR_CYAN . "  Starting Nexus Dev Environment...\n" . COLOR_RESET;

    $phpHost = '127.0.0.1';
    $phpPort = 8000;
    $publicDir = public_path();

    // Periksa apakah port PHP 8000 sudah terpakai
    $fp = @fsockopen($phpHost, $phpPort, $errno, $errstr, 0.5);
    if (is_resource($fp)) {
        fclose($fp);
        echo COLOR_YELLOW . "  Port {$phpPort} sedang digunakan, mencoba port 8080...\n" . COLOR_RESET;
        $phpPort = 8080;
    }

    // Cek apakah Vite Dev Server sudah berjalan di port 5173
    $viteHost = '127.0.0.1';
    $vitePort = 5173;
    $viteSocket = @fsockopen($viteHost, $vitePort, $errno, $errstr, 0.2);
    $viteAlreadyRunning = is_resource($viteSocket);
    if ($viteAlreadyRunning) {
        fclose($viteSocket);
        echo COLOR_GREEN . "  ✔ Vite Server:" . COLOR_RESET . " http://localhost:{$vitePort} " . COLOR_CYAN . "(sudah aktif di terminal lain)\n" . COLOR_RESET;
    } else {
        echo COLOR_GREEN . "  ✔ Vite Server:" . COLOR_RESET . " http://localhost:{$vitePort}\n";
    }

    echo COLOR_GRAY . "  Tekan Ctrl+C untuk menghentikan dev server.\n\n" . COLOR_RESET;

    // Perintah untuk PHP Built-in Server
    $phpCmd = sprintf('php -S %s:%d -t %s', $phpHost, $phpPort, escapeshellarg($publicDir));

    // Buka proses Vite hanya jika belum berjalan
    $viteProcess = null;
    if (!$viteAlreadyRunning) {
        $viteCmd = 'npm run dev';
        $viteProcess = proc_open($viteCmd, [
            0 => ['pipe', 'r'],
            1 => STDOUT,
            2 => STDERR,
        ], $vitePipes, __DIR__);
    }

    // Tangani sinyal termination untuk mematikan kedua proses dengan bersih
    if (function_exists('pcntl_signal')) {
        $cleanup = function () use ($viteProcess) {
            echo "\n" . COLOR_YELLOW . "  Mematikan Nexus Dev Server..." . COLOR_RESET . "\n";
            if (is_resource($viteProcess)) {
                $status = proc_get_status($viteProcess);
                if (!empty($status['pid'])) {
                    posix_kill($status['pid'], SIGTERM);
                }
                proc_close($viteProcess);
            }
            // Hapus file marker hot reload jika tertinggal
            $hot = __DIR__ . '/public/hot';
            if (file_exists($hot)) {
                @unlink($hot);
            }
            exit(0);
        };

        pcntl_signal(SIGINT, $cleanup);
        pcntl_signal(SIGTERM, $cleanup);
    }

    // Jalankan PHP server di foreground
    passthru($phpCmd);

    // Jika PHP server ditutup, tutup proses Vite juga
    if (is_resource($viteProcess)) {
        proc_terminate($viteProcess);
        proc_close($viteProcess);
    }
}

/**
 * Eksekusi migrasi database.
 */
function runMigrate(): void
{
    echo COLOR_BOLD . COLOR_CYAN . "=== Nexus Migrations ===" . COLOR_RESET . "\n";

    try {
        $migrator = new Migrator();
        $migrated = $migrator->run();

        if (empty($migrated)) {
            echo COLOR_GRAY . "Tidak ada migrasi baru untuk dijalankan (Database up to date).\n" . COLOR_RESET;
            return;
        }

        foreach ($migrated as $migration) {
            echo COLOR_GREEN . "  ✔ Berhasil : " . COLOR_RESET . $migration . "\n";
        }
        echo COLOR_BOLD . COLOR_GREEN . "\nSeluruh migrasi selesai dieksekusi!\n" . COLOR_RESET;
    } catch (Throwable $e) {
        echo COLOR_RED . "  ✖ Error Migrasi: " . $e->getMessage() . COLOR_RESET . "\n";
        exit(1);
    }
}

/**
 * Drop seluruh tabel dan eksekusi ulang seluruh migrasi dari awal.
 * Opsi: --seed untuk langsung menginjeksi seeder dasar.
 */
function runMigrateFresh(array $argv = []): void
{
    echo COLOR_BOLD . COLOR_MAGENTA . "=== Nexus Migrate Fresh ===" . COLOR_RESET . "\n";
    echo COLOR_YELLOW . "  Mengosongkan seluruh tabel database...\n" . COLOR_RESET;

    try {
        $migrator = new Migrator();
        $migrated = $migrator->fresh();

        foreach ($migrated as $migration) {
            echo COLOR_GREEN . "  ✔ Berhasil : " . COLOR_RESET . $migration . "\n";
        }
        echo COLOR_BOLD . COLOR_GREEN . "\nSeluruh skema tabel berhasil dibuat ulang dari awal!\n" . COLOR_RESET;

        $hasSeed = in_array('--seed', $argv, true);
        if ($hasSeed) {
            echo "\n" . COLOR_CYAN . "🌱 Menjalankan Seeder Otomatis (--seed)...\n" . COLOR_RESET;
            require_once __DIR__ . '/database/seeders/RoleSeeder.php';
            \Database\Seeders\RoleSeeder::run();
            echo COLOR_GREEN . "  ✔ RoleSeeder selesai dieksekusi.\n" . COLOR_RESET;

            require_once __DIR__ . '/database/seeders/CinemaSeeder.php';
            \Database\Seeders\CinemaSeeder::run();
            echo COLOR_GREEN . "  ✔ CinemaSeeder selesai dieksekusi.\n" . COLOR_RESET;
            echo COLOR_BOLD . COLOR_GREEN . "\nDatabase fresh & seed berhasil dipersiapkan!\n\n" . COLOR_RESET;
        }
    } catch (Throwable $e) {
        echo COLOR_RED . "  ✖ Error Migrate Fresh: " . $e->getMessage() . COLOR_RESET . "\n";
        exit(1);
    }
}

/**
 * Rollback batch migrasi terakhir.
 */
function runMigrateRollback(): void
{
    echo COLOR_BOLD . COLOR_YELLOW . "=== Nexus Rollback ===" . COLOR_RESET . "\n";

    try {
        $migrator = new Migrator();
        $rolledBack = $migrator->rollback();

        if (empty($rolledBack)) {
            echo COLOR_GRAY . "Tidak ada batch migrasi yang dapat dibatalkan.\n" . COLOR_RESET;
            return;
        }

        foreach ($rolledBack as $migration) {
            echo COLOR_YELLOW . "  ↺ Rolled back : " . COLOR_RESET . $migration . "\n";
        }
        echo COLOR_BOLD . COLOR_GREEN . "\nBatch migrasi berhasil di-rollback!\n" . COLOR_RESET;
    } catch (Throwable $e) {
        echo COLOR_RED . "  ✖ Error Rollback: " . $e->getMessage() . COLOR_RESET . "\n";
        exit(1);
    }
}

/**
 * Tampilkan status seluruh migrasi dalam format tabel.
 */
function runMigrateStatus(): void
{
    echo COLOR_BOLD . COLOR_CYAN . "=== Status Migrasi Database ===" . COLOR_RESET . "\n\n";

    $migrator = new Migrator();
    $statusList = $migrator->status();

    if (empty($statusList)) {
        echo COLOR_GRAY . "Belum ada file migrasi pada direktori database/migrations/.\n" . COLOR_RESET;
        return;
    }

    printf("%-50s | %-10s | %-6s | %-20s\n", "File Migrasi", "Status", "Batch", "Tanggal Eksekusi");
    echo str_repeat('-', 95) . "\n";

    foreach ($statusList as $item) {
        $statusLabel = $item['ran'] ? COLOR_GREEN . "Ran" . COLOR_RESET : COLOR_RED . "Pending" . COLOR_RESET;
        $batch = $item['batch'] !== null ? (string) $item['batch'] : '-';
        $time = $item['executed_at'] ?? '-';

        printf("%-50s | %-19s | %-6s | %-20s\n", $item['migration'], $statusLabel, $batch, $time);
    }
    echo "\n";
}

/**
 * Buat symbolic link dari storage/app/public ke public/storage.
 */
function runStorageLink(): void
{
    printBanner();
    echo COLOR_CYAN . "  Menghubungkan Storage Link...\n" . COLOR_RESET;

    $target = storage_path('app/public');
    $link = public_path('storage');

    if (!is_dir($target)) {
        @mkdir($target, 0755, true);
    }

    $linkParent = dirname($link);
    if (!is_dir($linkParent)) {
        @mkdir($linkParent, 0755, true);
    }

    if (file_exists($link) || is_link($link)) {
        echo COLOR_YELLOW . "  [!] Tautan [{$link}] sudah ada sebelumnya.\n\n" . COLOR_RESET;
        return;
    }

    $success = false;

    if (function_exists('symlink')) {
        $success = @symlink($target, $link);
    } elseif (function_exists('exec')) {
        @exec('ln -s ' . escapeshellarg($target) . ' ' . escapeshellarg($link));
        $success = is_link($link);
    }

    if ($success) {
        echo COLOR_GREEN . "  ✔ Tautan [{$link}] berhasil dibuat -> [{$target}].\n\n" . COLOR_RESET;
    } else {
        echo COLOR_RED . "  ✖ Gagal membuat symbolic link [{$link}].\n" . COLOR_RESET;
        if (!function_exists('symlink')) {
            echo COLOR_YELLOW . "  Penyebab: Fungsi 'symlink' dinonaktifkan di pengaturan PHP aaPanel (Disabled functions).\n" . COLOR_RESET;
            echo COLOR_CYAN . "  Jalankan perintah ini di terminal server Anda untuk membuat link secara manual:\n" . COLOR_RESET;
            echo COLOR_WHITE . "  ln -s " . escapeshellarg($target) . " " . escapeshellarg($link) . "\n\n" . COLOR_RESET;
        }
    }
}

/**
 * Generator Controller/Handler baru.
 */
function makeController(?string $name): void
{
    if (empty($name)) {
        echo COLOR_RED . "Error: Mohon tentukan nama controller. Contoh: php nexus make:controller UserController\n" . COLOR_RESET;
        exit(1);
    }

    $name = trim($name);
    if (!str_ends_with($name, 'Controller') && !str_ends_with($name, 'Handler')) {
        $name .= 'Controller';
    }

    $targetDir = __DIR__ . '/app/Handlers';
    if (!is_dir($targetDir)) {
        mkdir($targetDir, 0755, true);
    }

    $targetFile = $targetDir . '/' . $name . '.php';

    if (file_exists($targetFile)) {
        echo COLOR_YELLOW . "File [app/Handlers/{$name}.php] sudah ada.\n" . COLOR_RESET;
        return;
    }

    $stub = <<<PHP
<?php

declare(strict_types=1);

namespace App\Handlers;

use Core\Http\Request;
use Core\Http\Response;

class {$name} extends Controller
{
    /**
     * Tampilkan resource utama.
     */
    public function index(Request \$request): Response
    {
        return \$this->json([
            'message' => 'Hello from {$name}!',
        ]);
    }
}
PHP;

    file_put_contents($targetFile, $stub);
    echo COLOR_GREEN . "✔ Controller berhasil dibuat:" . COLOR_RESET . " app/Handlers/{$name}.php\n";
}

