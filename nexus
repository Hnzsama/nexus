#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Nexus Framework - Official CLI Utility
 * 
 * Command Runner elegan untuk pengembangan, migrasi skema database,
 * code generator (controller, model, migration), serta concurrent dev server.
 */

if (php_sapi_name() !== 'cli') {
    fwrite(STDERR, "Nexus CLI hanya dapat dijalankan melalui terminal CLI.\n");
    exit(1);
}

require_once __DIR__ . '/vendor/autoload.php';

use Core\App;
use Core\Database\Migrator;
use Core\Database\Schema\Blueprint;
use Core\Database\Schema\Schema;

/** @var App $app */
$app = require_once __DIR__ . '/bootstrap/app.php';

// ANSI Color Constants untuk UI CLI yang modern
const COLOR_RESET   = "\033[0m";
const COLOR_BOLD    = "\033[1m";
const COLOR_RED     = "\033[31m";
const COLOR_GREEN   = "\033[32m";
const COLOR_YELLOW  = "\033[33m";
const COLOR_BLUE    = "\033[34m";
const COLOR_MAGENTA = "\033[35m";
const COLOR_CYAN    = "\033[36m";
const COLOR_WHITE   = "\033[37m";
const COLOR_GRAY    = "\033[90m";

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'help';
$argument = $argv[2] ?? null;

// Route Command
match ($command) {
    'dev' => runDevServer(),
    'migrate' => runMigrate(),
    'migrate:fresh' => runMigrateFresh($argv),
    'migrate:rollback' => runMigrateRollback(),
    'migrate:status' => runMigrateStatus(),
    'storage:link' => runStorageLink(),
    'make:controller', 'make:handler' => makeController($argument),
    'make:model' => makeModel($argument),
    'make:request' => makeRequest($argument),
    'make:migration' => makeMigration($argument),
    'seats:cleanup' => runSeatsCleanup(),
    'cinema:seed', 'db:seed' => runCinemaSeed(),
    'swagger:generate' => runSwaggerGenerate(),
    'help', 'list', '--help', '-h' => showHelp(),
    default => showUnknownCommand($command),
};

exit(0);


