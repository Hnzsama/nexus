/**
 * Generator file migrasi baru menggunakan Schema Blueprint.
 */
function makeMigration(?string $name): void
{
    if (empty($name)) {
        echo COLOR_RED . "Error: Mohon tentukan nama migrasi. Contoh: php nexus make:migration create_products_table\n" . COLOR_RESET;
        exit(1);
    }

    $name = strtolower(trim($name));
    $name = preg_replace('/[^a-z0-9_]/', '_', $name);

    $timestamp = date('Y_m_d_His');
    $fileName = "{$timestamp}_{$name}";
    $targetFile = __DIR__ . "/database/migrations/{$fileName}.php";

    // Format nama class: create_products_table -> CreateProductsTable
    $className = str_replace(' ', '', ucwords(str_replace('_', ' ', $name)));

    // Tebak nama tabel
    $tableName = 'my_table';
    if (preg_match('/^create_(.+)_table$/', $name, $matches)) {
        $tableName = $matches[1];
    }

    $stub = <<<PHP
<?php

declare(strict_types=1);

use Core\Database\Migration;

class {$className} extends Migration
{
    public function up(PDO \$pdo): void
    {
        \$this->execute("
            CREATE TABLE IF NOT EXISTS {$tableName} (
                id INT AUTO_INCREMENT PRIMARY KEY,
                -- Kolom Anda di sini:
                -- name VARCHAR(255) NOT NULL,
                created_at DATETIME NOT NULL,
                updated_at DATETIME NOT NULL
            );
        ", \$pdo);
    }

    public function down(PDO \$pdo): void
    {
        \$this->execute("DROP TABLE IF EXISTS {$tableName};", \$pdo);
    }
}
PHP;

    file_put_contents($targetFile, $stub);
    echo COLOR_GREEN . "✔ File migrasi berhasil dibuat:" . COLOR_RESET . " database/migrations/{$fileName}.php\n";
}

